PORT=5000
# Dùng cho "npm run dev" ngoài Docker. Khi chạy qua docker-compose.yml, giá trị này bị ghi đè bởi
# environment.MONGO_URI của service 'server' (trỏ tới service 'mongo' kèm auth, xem docker-compose.yml).
MONGO_URI=mongodb://localhost:27018/chatapp

# Redis cho rate-limit tập trung (server/src/utils/rateLimiter.js) — để trống thì tự rơi về
# in-memory (chỉ đúng khi chạy 1 instance). Chỉ cần set khi scale ngang nhiều instance.
REDIS_URL=
# Ký/verify 2 loại JWT còn dùng — bootstrap token (15 phút) và reset-password token (10 phút).
# Không xoay vòng key (khác ENCRYPTION_KEY bên dưới) — cả 2 token đều sống rất ngắn, đổi secret
# chỉ ảnh hưởng vài token đang treo trong vài phút, không cần giữ keyring.
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Firebase Admin SDK: đường dẫn TUYỆT ĐỐI tới service-account JSON, không commit file đó.
# Dev Windows ví dụ: C:\\Users\\you\\.secrets\\chat-app-firebase-admin.json
GOOGLE_APPLICATION_CREDENTIALS=

# TURN/coturn cho WebRTC relay. Coturn phải bật use-auth-secret và dùng cùng static-auth-secret.
# Để trống cả hai khi phát triển local (client chỉ dùng STUN, không relay được qua symmetric NAT).
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
TURN_SHARED_SECRET=

# Số hop reverse proxy thật trước server (Cloudflare, Nginx...) — 0 = tắt (mặc định, an toàn cho
# dev local). Chỉ đặt >0 sau khi đã xác nhận proxy đó đang thật sự chạy, nếu không sẽ mở đường
# giả mạo IP qua header X-Forwarded-For, phá vỡ rate-limit theo IP.
TRUST_PROXY_HOPS=0

# mediasoup (SFU cho gọi nhóm). MEDIASOUP_ANNOUNCED_IP bắt buộc khi deploy sau NAT/reverse proxy —
# để trống thì mediasoup announce IP nội bộ, client ngoài không kết nối được. Để trống khi dev local.
MEDIASOUP_ANNOUNCED_IP=
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999
MEDIASOUP_NUM_WORKERS=

# Cloudflare Turnstile (CAPTCHA) cho form đăng ký/quên mật khẩu — để trống thì bỏ qua verify (dev local)
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Email service — gửi qua HTTP API của Brevo (server/src/config/mailer.js), KHÔNG dùng SMTP thô
# vì nhiều PaaS (Render, Railway, Heroku...) chặn/giới hạn outbound port SMTP 25/587 gây treo
# request cả phút rồi timeout. Lấy BREVO_API_KEY tại app.brevo.com → Settings → SMTP & API → API Keys.
BREVO_API_KEY=your_brevo_api_key_here
SMTP_FROM=your_sender_email@domain.com

# Cloudinary credentials for media upload
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Cloudflare R2 — bucket private chứa attachment chat E2EE. Các giá trị này chỉ có ở server;
# client nhận presigned URL ngắn hạn sau khi server kiểm tra thành viên phòng.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=chat-attachments

# Cryptography (mã hóa PII/report tại DB, server/src/utils/crypto.js) & AI Moderation (Option 1)
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

# Xoay vòng ENCRYPTION_KEY (tùy chọn) — không set thì tự dùng ENCRYPTION_KEY làm keyring 1 phần tử.
# Định dạng ENCRYPTION_KEYS: "kid1:key1,kid2:key2" (mỗi key vẫn là chuỗi hex 32 byte như
# ENCRYPTION_KEY). ENCRYPTION_KEY_CURRENT_KID chọn key dùng để MÃ HÓA dữ liệu mới — mọi key trong
# ENCRYPTION_KEYS vẫn dùng để GIẢI MÃ dữ liệu cũ.
# Khi rotate: (1) thêm 1 cặp kid:key mới vào ENCRYPTION_KEYS, đổi ENCRYPTION_KEY_CURRENT_KID sang
# kid đó (server đọc dữ liệu cũ vẫn bình thường nhờ còn key cũ trong ring); (2) chạy
# `node src/scripts/rotate-encryption-key.js` để re-encrypt toàn bộ dữ liệu hiện có sang key mới;
# (3) sau khi script báo hoàn tất, mới xóa key cũ khỏi ENCRYPTION_KEYS — xóa sớm khi dữ liệu chưa
# re-encrypt hết sẽ làm mất khả năng đọc phần dữ liệu còn lại.
ENCRYPTION_KEYS=
ENCRYPTION_KEY_CURRENT_KID=

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=18000

# Google Safe Browsing — kiểm tra link người dùng gửi có an toàn không (server/src/routes/security.js)
# để trống thì coi mọi link là an toàn (bỏ qua kiểm tra)
SAFE_BROWSING_API_KEY=

# Giới hạn IP được phép đăng nhập/dùng tài khoản role admin (server/src/middleware/auth.js) —
# để trống thì không giới hạn. Danh sách IP cách nhau dấu phẩy, vd: "1.2.3.4,5.6.7.8". Chỉ đáng
# tin khi TRUST_PROXY_HOPS ở trên đã đặt đúng số hop, nếu không req.ip có thể bị giả mạo.
ADMIN_IP_WHITELIST=

# WebAuthn / Passkey. Production phải dùng hostname frontend (không scheme/port) và HTTPS origin.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Chat App
WEBAUTHN_ORIGIN=http://localhost:5173
